ldValue('NAME') || '_';\n  return varname + \".remote_led5()\" + \"\\n\";\n}","toolbox":"\n<category name=\"PropTx\" colour=\"#2E9E72\" hidden=\"true\" toolboxitemid=\"custom_proptx\">\n<title text=\"PropTx\" docsLink=\"https://github.com/atrep123/m5-prop-lora\"></title>\n<block type=\"custom_proptx_init\">\n  <value name=\"tx\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">13</field>\n    </shadow>\n  </value>\n  <value name=\"rx\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">15</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_proptx_preview\">\n  <value name=\"colors\">\n    <shadow type=\"text\">\n      <field name=\"TEXT\"/>\n    </shadow>\n  </value>\n</block><block type=\"custom_proptx_fire\">\n  <value name=\"colors\">\n    <shadow type=\"text\">\n      <field name=\"TEXT\"/>\n    </shadow>\n  </value>\n</block><block type=\"custom_proptx_stop\"/><block type=\"custom_proptx_arm\"/><block type=\"custom_proptx_remote_led\">\n  <value name=\"which\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">3</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_proptx_sync_palette\">\n  <value name=\"colors\">\n    <shadow type=\"text\">\n      <field name=\"TEXT\"/>\n    </shadow>\n  </value>\n</block><block type=\"custom_proptx_reply\"/><block type=\"custom_proptx_hue_color\">\n  <value name=\"deg\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_proptx_default_hues\"/><block type=\"custom_proptx_default_colors\"/><block type=\"custom_proptx_palette_from_hues\">\n  <value name=\"hues\">\n    <shadow type=\"text\">\n      <field name=\"TEXT\"/>\n    </shadow>\n  </value>\n</block><block type=\"custom_proptx_set_color\">\n  <value name=\"colors\">\n    <shadow type=\"text\">\n      <field name=\"TEXT\"/>\n    </shadow>\n  </value>\n  <value name=\"index\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">1</field>\n    </shadow>\n  </value>\n  <value name=\"color\">\n    <shadow type=\"text\">\n      <field name=\"TEXT\"/>\n    </shadow>\n  </value>\n</block><block type=\"custom_proptx_first_four\">\n  <value name=\"colors\">\n    <shadow type=\"text\">\n      <field name=\"TEXT\"/>\n    </shadow>\n  </value>\n</block><block type=\"custom_proptx_rgb_color\">\n  <value name=\"r\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">255</field>\n    </shadow>\n  </value>\n  <value name=\"g\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n  <value name=\"b\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_proptx_rgb888\">\n  <value name=\"color\">\n    <shadow type=\"text\">\n      <field name=\"TEXT\"/>\n    </shadow>\n  </value>\n</block><block type=\"custom_proptx_remote_led3\"/><block type=\"custom_proptx_remote_led5\"/>\n</category>\n","toolboxitemid":"custom_proptx","block_type":["custom_proptx_init","custom_proptx_preview","custom_proptx_fire","custom_proptx_stop","custom_proptx_arm","custom_proptx_remote_led","custom_proptx_sync_palette","custom_proptx_reply","custom_proptx_hue_color","custom_proptx_default_hues","custom_proptx_default_colors","custom_proptx_palette_from_hues","custom_proptx_set_color","custom_proptx_first_four","custom_proptx_rgb_color","custom_proptx_rgb888","custom_proptx_remote_led3","custom_proptx_remote_led5"]},"data":{"name":"PropTx","note":{"en":"Prop TX UIFlow2 bridge for the authenticated prop_frame sender."},"details":{"color":"#2E9E72","link":"https://github.com/atrep123/m5-prop-lora","image":"","category":"Custom"},"header":{"file":"PropTx","time":"2026-06-10","author":"","email":"","license":"MIT License"},"assignments":[],"example":"","source_internal":"","source_external":"","members":[{"name":"__init__","note":{},"label":{"en":"%1 Prop init TX %2 RX %3"},"params":[{"name":"tx","type":"int","default":"13","note":{},"field":"number","max":"48","min":"0"},{"name":"rx","type":"int","default":"15","note":{},"field":"number","max":"48","min":"0"}],"return":"","source":"        global prop_frame, prop_ui\n        import prop_frame\n        import prop_ui\n        from hardware import UART\n        self._uart = UART(1, baudrate=115200, bits=8, parity=None, stop=1, tx=tx, rx=rx)\n        self._tx = prop_frame.PropSender()\n        self._prop_frame = prop_frame\n        self._prop_ui = prop_ui\n        self._uart.write('\\n')","ast_return":{"code":null,"id":null},"doc_return":null},{"name":"preview","note":{},"label":{"en":"Prop PREVIEW %1 colors %2"},"params":[{"name":"colors","type":"list","default":null,"note":{},"field":""}],"return":"","source":"        self._uart.write(self._tx.preview_line(colors))","ast_return":{"code":null,"id":null},"doc_return":null},{"name":"fire","note":{},"label":{"en":"Prop ODPAL %1 colors %2"},"params":[{"name":"colors","type":"list","default":null,"note":{},"field":""}],"return":"","source":"        self._uart.write(self._tx.fire_line(colors))","ast_return":{"code":null,"id":null},"doc_return":null},{"name":"stop","note":{},"label":{"en":"Prop STOP %1"},"params":[],"return":"","source":"        self._uart.write(self._tx.stop_line())","ast_return":{"code":null,"id":null},"doc_return":null},{"name":"arm","note":{},"label":{"en":"Prop ARM %1"},"params":[],"return":"","source":"        self._uart.write(self._tx.arm_line())","ast_return":{"code":null,"id":null},"doc_return":null},{"name":"remote_led","note":{},"label":{"en":"Prop remote LED %1 which %2"},"params":[{"name":"which","type":"int","default":"3","note":{},"field":"number","max":"5","min":"3"}],"return":"","source":"        bit = self._prop_frame.REMOTE_LED_BIT_LED3 if which == 3 else self._prop_frame.REMOTE_LED_BIT_LED5\n        self._uart.write(self._tx.remote_led_line(bit))","ast_return":{"code":null,"id":null},"doc_return":null},{"name":"sync_palette","note":{},"label":{"en":"Prop sync palette %1 colors %2"},"params":[{"name":"colors","type":"list","default":null,"note":{},"field":""}],"return":"","source":"        self._uart.write(self._tx.palette_line(1, False, colors, track_ack=False))","ast_return":{"code":null,"id":null},"doc_return":null},{"name":"reply","note":{},"label":{"en":"Prop reply %1"},"params":[],"return":"","source":"        if not self._uart.any():\n            return ''\n        data = self._uart.read() or b''\n        if isinstance(data, str):\n            return data\n        try:\n            return data.decode()\n        except Exception:\n            return ''","ast_return":{"code":null,"id":null},"doc_return":null},{"name":"hue_color","note":{},"label":{"en":"Prop hue %1 deg %2 to color"},"params":[{"name":"deg","type":"int","default":"0","note":{},"field":"number","max":"359","min":"0"}],"return":"","source":"        return self._prop_ui.hsv(deg)","ast_return":{"code":null,"id":null},"doc_return":null},{"name":"default_hues","note":{},"label":{"en":"Prop default hues %1"},"params":[],"return":"","source":"        return [0, 120, 240, 210, 60]","ast_return":{"code":null,"id":null},"doc_return":null},{"name":"default_colors","note":{},"label":{"en":"Prop default colors %1"},"params":[],"return":"","source":"        return self._prop_ui.palette_from_hues(self.default_hues())","ast_return":{"code":null,"id":null},"doc_return":null},{"name":"palette_from_hues","note":{},"label":{"en":"Prop colors from hues %1 hues %2"},"params":[{"name":"hues","type":"list","default":null,"note":{},"field":""}],"return":"","source":"        return self._prop_ui.palette_from_hues(hues)","ast_return":{"code":null,"id":null},"doc_return":null},{"name":"set_color","note":{},"label":{"en":"Prop set color %1 colors %2 LED %3 color %4"},"params":[{"name":"colors","type":"list","default":null,"note":{},"field":""},{"name":"index","type":"int","default":"1","note":{},"field":"number","max":"5","min":"1"},{"name":"color","type":"tuple","default":null,"note":{},"field":""}],"return":"","source":"        out = list(colors)\n        if not out:\n            return [color]\n        try:\n            pos = int(index)\n        except Exception:\n            pos = 1\n        pos = max(1, min(pos, len(out)))\n        out[pos - 1] = color\n        return out","ast_return":{"code":null,"id":null},"doc_return":null},{"name":"first_four","note":{},"label":{"en":"Prop first four %1 colors %2"},"params":[{"name":"colors","type":"list","default":null,"note":{},"field":""}],"return":"","source":"        return list(colors)[:4]","ast_return":{"code":null,"id":null},"doc_return":null},{"name":"rgb_color","note":{},"label":{"en":"Prop RGB %1 R %2 G %3 B %4"},"params":[{"name":"r","type":"int","default":"255","note":{},"field":"number","max":"255","min":"0"},{"name":"g","type":"int","default":"0","note":{},"field":"number","max":"255","min":"0"},{"name":"b","type":"int","default":"0","note":{},"field":"number","max":"255","min":"0"}],"return":"","source":"        def clamp(value):\n            return max(0, min(255, int(value)))\n\n        return (clamp(r), clamp(g), clamp(b))","ast_return":{"code":null,"id":null},"doc_return":null},{"name":"rgb888","note":{},"label":{"en":"Prop RGB888 %1 color %2"},"params":[{"name":"color","type":"tuple","default":null,"note":{},"field":""}],"return":"","source":"        return self._prop_ui.rgb888(color)","ast_return":{"code":null,"id":null},"doc_return":null},{"name":"remote_led3","note":{},"label":{"en":"Prop remote LED3 %1"},"params":[],"return":"","source":"        self.remote_led(3)","ast_return":{"code":null,"id":null},"doc_return":null},{"name":"remote_led5","note":{},"label":{"en":"Prop remote LED5 %1"},"params":[],"return":"","source":"        self.remote_led(5)","ast_return":{"code":null,"id":null},"doc_return":null}],"python_file_name":"PropTx"},"pyCode":"\"\"\"\nfile     PropTx\ntime     2026-06-10\nauthor\nemail\nlicense  MIT License\n\"\"\"\n\n\nclass PropTx:\n    \"\"\"\n    note:\n        en: Prop TX UIFlow2 bridge for the authenticated prop_frame sender.\n    details:\n        color: '#2E9E72'\n        link: https://github.com/atrep123/m5-prop-lora\n        image: ''\n        category: Custom\n    example: ''\n    \"\"\"\n\n    def __init__(self, tx: int = 13, rx: int = 15):\n        \"\"\"\n        label:\n            en: '%1 Prop init TX %2 RX %3'\n        params:\n            tx:\n                name: tx\n                type: int\n                default: '13'\n                field: number\n                min: '0'\n                max: '48'\n            rx:\n                name: rx\n                type: int\n                default: '15'\n                field: number\n                min: '0'\n                max: '48'\n        \"\"\"\n        global prop_frame, prop_ui\n        import prop_frame\n        import prop_ui\n        from hardware import UART\n        self._uart = UART(1, baudrate=115200, bits=8, parity=None, stop=1, tx=tx, rx=rx)\n        self._tx = prop_frame.PropSender()\n        self._prop_frame = prop_frame\n        self._prop_ui = prop_ui\n        self._uart.write('\\n')\n\n    def preview(self, colors):\n        \"\"\"\n        label:\n            en: 'Prop PREVIEW %1 colors %2'\n        params:\n            colors:\n                name: colors\n                type: list\n        \"\"\"\n        self._uart.write(self._tx.preview_line(colors))\n\n    def fire(self, colors):\n        \"\"\"\n        label:\n            en: 'Prop ODPAL %1 colors %2'\n        params:\n            colors:\n                name: colors\n                type: list\n        \"\"\"\n        self._uart.write(self._tx.fire_line(colors))\n\n    def stop(self):\n        \"\"\"\n        label:\n            en: 'Prop STOP %1'\n        \"\"\"\n        self._uart.write(self._tx.stop_line())\n\n    def arm(self):\n        \"\"\"\n        label:\n            en: 'Prop ARM %1'\n        \"\"\"\n        self._uart.write(self._tx.arm_line())\n\n    def remote_led(self, which: int = 3):\n        \"\"\"\n        label:\n            en: 'Prop remote LED %1 which %2'\n        params:\n            which:\n                name: which\n                type: int\n                default: '3'\n                field: number\n                min: '3'\n                max: '5'\n        \"\"\"\n        bit = self._prop_frame.REMOTE_LED_BIT_LED3 if which == 3 else self._prop_frame.REMOTE_LED_BIT_LED5\n        self._uart.write(self._tx.remote_led_line(bit))\n\n    def sync_palette(self, colors):\n        \"\"\"\n        label:\n            en: 'Prop sync palette %1 colors %2'\n        params:\n            colors:\n                name: colors\n                type: list\n        \"\"\"\n        self._uart.write(self._tx.palette_line(1, False, colors, track_ack=False))\n\n    def reply(self) -> str:\n        \"\"\"\n        label:\n            en: 'Prop reply %1'\n        \"\"\"\n        if not self._uart.any():\n            return ''\n        data = self._uart.read() or b''\n        if isinstance(data, str):\n            return data\n        try:\n            return data.decode()\n        except Exception:\n            return ''\n\n    def hue_color(self, deg: int = 0) -> tuple:\n        \"\"\"\n        label:\n            en: 'Prop hue %1 deg %2 to color'\n        params:\n            deg:\n                name: deg\n                type: int\n                default: '0'\n                field: number\n                min: '0'\n                max: '359'\n        \"\"\"\n        return self._prop_ui.hsv(deg)\n\n    def default_hues(self) -> list:\n        \"\"\"\n        label:\n            en: 'Prop default hues %1'\n        \"\"\"\n        return [0, 120, 240, 210, 60]\n\n    def default_colors(self) -> list:\n        \"\"\"\n        label:\n            en: 'Prop default colors %1'\n        \"\"\"\n        return self._prop_ui.palette_from_hues(self.default_hues())\n\n    def palette_from_hues(self, hues) -> list:\n        \"\"\"\n        label:\n            en: 'Prop colors from hues %1 hues %2'\n        params:\n            hues:\n                name: hues\n                type: list\n        \"\"\"\n        return self._prop_ui.palette_from_hues(hues)\n\n    def set_color(self, colors, index: int = 1, color=(255, 0, 0)) -> list:\n        \"\"\"\n        label:\n            en: 'Prop set color %1 colors %2 LED %3 color %4'\n        params:\n            colors:\n                name: colors\n                type: list\n            index:\n                name: index\n                type: int\n                default: '1'\n                field: number\n                min: '1'\n                max: '5'\n            color:\n                name: color\n                type: tuple\n        \"\"\"\n        out = list(colors)\n        if not out:\n            return [color]\n        try:\n            pos = int(index)\n        except Exception:\n            pos = 1\n        pos = max(1, min(pos, len(out)))\n        out[pos - 1] = color\n        return out\n\n    def first_four(self, colors) -> list:\n        \"\"\"\n        label:\n            en: 'Prop first four %1 colors %2'\n        params:\n            colors:\n                name: colors\n                type: list\n        \"\"\"\n        return list(colors)[:4]\n\n    def rgb_color(self, r: int = 255, g: int = 0, b: int = 0) -> tuple:\n        \"\"\"\n        label:\n            en: 'Prop RGB %1 R %2 G %3 B %4'\n        params:\n            r:\n                name: r\n                type: int\n                default: '255'\n                field: number\n                min: '0'\n                max: '255'\n            g:\n                name: g\n                type: int\n                default: '0'\n                field: number\n                min: '0'\n                max: '255'\n            b:\n                name: b\n                type: int\n                default: '0'\n                field: number\n                min: '0'\n                max: '255'\n        \"\"\"\n        def clamp(value):\n            return max(0, min(255, int(value)))\n\n        return (clamp(r), clamp(g), clamp(b))\n\n    def rgb888(self, color) -> int:\n        \"\"\"\n        label:\n            en: 'Prop RGB888 %1 color %2'\n        params:\n            color:\n                name: color\n                type: tuple\n        \"\"\"\n        return self._prop_ui.rgb888(color)\n\n    def remote_led3(self):\n        \"\"\"\n        label:\n            en: 'Prop remote LED3 %1'\n        \"\"\"\n        self.remote_led(3)\n\n    def remote_led5(self):\n        \"\"\"\n        label:\n            en: 'Prop remote LED5 %1'\n        \"\"\"\n        self.remote_led(5)\n","version":"alpha2"}