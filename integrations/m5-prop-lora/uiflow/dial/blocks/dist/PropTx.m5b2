{"category":"PropTx","color":"#2E9E72","uiflow2":{"jscode":"const CUSTOM_PROPTX_LANGUAGES = {\n  \"CUSTOM_PROPTX_INIT\": {\n    \"en\": \"%1 Prop init TX %2 RX %3\"\n  },\n  \"CUSTOM_PROPTX_PREVIEW\": {\n    \"en\": \"Prop PREVIEW %1 colors %2\"\n  },\n  \"CUSTOM_PROPTX_FIRE\": {\n    \"en\": \"Prop ODPAL %1 colors %2\"\n  },\n  \"CUSTOM_PROPTX_STOP\": {\n    \"en\": \"Prop STOP %1\"\n  },\n  \"CUSTOM_PROPTX_ARM\": {\n    \"en\": \"Prop ARM %1\"\n  },\n  \"CUSTOM_PROPTX_REPLY\": {\n    \"en\": \"Prop reply %1\"\n  },\n  \"CUSTOM_PROPTX_DEFAULT_COLORS\": {\n    \"en\": \"Prop default colors %1\"\n  },\n  \"CUSTOM_PROPTX_FIRST_FOUR\": {\n    \"en\": \"Prop first four %1 colors %2\"\n  },\n  \"CUSTOM_PROPTX_RGB_COLOR\": {\n    \"en\": \"Prop RGB %1 R %2 G %3 B %4\"\n  },\n  \"CUSTOM_PROPTX_RGB888\": {\n    \"en\": \"Prop RGB888 %1 color %2\"\n  }\n};\n\nconst initType = 'custom_proptx_init';\nBlockly.BlockRegExpList['custom_proptx'] = {\n  regexp: new RegExp(/^custom_proptx_/),\n  code: \"from PropTx import PropTx\",\n  initBlockType: initType,\n  categoryId: 'custom_proptx',\n}\nBlockly.utils.registerLanguages(CUSTOM_PROPTX_LANGUAGES)\n\nBlockly.Msg.CUSTOM_PROPTX_HUE = '#2E9E72'\nBlockly.Msg.CUSTOM_PROPTX = 'PropTx'\n\nBlockly.utils.getcustom_proptxOptions = function() {\n  let options = [];\n  let list = Blockly.utils.getCustomNameList(initType);\n  for (let i = 0; i < list.length; i++) {\n    let value = list[i];\n    options.push([String(value), String(value)]);\n  }\n  if (options.length === 0) return [\n    ['proptx_0', 'proptx_0']\n  ];\n  return options;\n}\n\nBlockly.Blocks[\"custom_proptx_init\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_PROPTX_INIT,\n      'args0': [\n        {\n          'type': 'field_input',\n          'name': 'NAME',\n          'text': 'proptx_0'\n        },\n        {\n          'type': 'input_value',\n          'name': 'tx'\n        },\n        {\n          'type': 'input_value',\n          'name': 'rx'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#2E9E72\",\n      \"tool\": []\n    };\n  }\n}\n\nBlockly.Python[\"custom_proptx_init\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var tx = Blockly.Python.valueToCode(block, 'tx', Blockly.Python.ORDER_FUNCTION_CALL) || \"13\";\n  var rx = Blockly.Python.valueToCode(block, 'rx', Blockly.Python.ORDER_FUNCTION_CALL) || \"15\";\n  return varname + \" = PropTx(\" + tx + \", \" + rx + \")\\n\";\n}\n\nBlockly.Blocks[\"custom_proptx_preview\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_PROPTX_PREVIEW,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_proptxOptions\n        },\n        {\n          'type': 'input_value',\n          'name': 'colors'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#2E9E72\",\n      \"tool\": []\n    };\n  }\n}\n\nBlockly.Python[\"custom_proptx_preview\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var colors = Blockly.Python.valueToCode(block, 'colors', Blockly.Python.ORDER_FUNCTION_CALL) || \"[]\";\n  return varname + \".preview(\" + colors + \")\" + \"\\n\";\n}\n\nBlockly.Blocks[\"custom_proptx_fire\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_PROPTX_FIRE,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_proptxOptions\n        },\n        {\n          'type': 'input_value',\n          'name': 'colors'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#2E9E72\",\n      \"tool\": []\n    };\n  }\n}\n\nBlockly.Python[\"custom_proptx_fire\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var colors = Blockly.Python.valueToCode(block, 'colors', Blockly.Python.ORDER_FUNCTION_CALL) || \"[]\";\n  return varname + \".fire(\" + colors + \")\" + \"\\n\";\n}\n\nBlockly.Blocks[\"custom_proptx_stop\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_PROPTX_STOP,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_proptxOptions\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#2E9E72\",\n      \"tool\": []\n    };\n  }\n}\n\nBlockly.Python[\"custom_proptx_stop\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  return varname + \".stop()\" + \"\\n\";\n}\n\nBlockly.Blocks[\"custom_proptx_arm\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_PROPTX_ARM,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_proptxOptions\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#2E9E72\",\n      \"tool\": []\n    };\n  }\n}\n\nBlockly.Python[\"custom_proptx_arm\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  return varname + \".arm()\" + \"\\n\";\n}\n\nBlockly.Blocks[\"custom_proptx_reply\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_PROPTX_REPLY,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_proptxOptions\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#2E9E72\",\n      \"tool\": []\n    };\n  }\n}\n\nBlockly.Python[\"custom_proptx_reply\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  return [varname + \".reply()\", Blockly.Python.ORDER_NONE];\n}\n\nBlockly.Blocks[\"custom_proptx_default_colors\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_PROPTX_DEFAULT_COLORS,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_proptxOptions\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#2E9E72\",\n      \"tool\": []\n    };\n  }\n}\n\nBlockly.Python[\"custom_proptx_default_colors\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  return [varname + \".default_colors()\", Blockly.Python.ORDER_NONE];\n}\n\nBlockly.Blocks[\"custom_proptx_first_four\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_PROPTX_FIRST_FOUR,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_proptxOptions\n        },\n        {\n          'type': 'input_value',\n          'name': 'colors'\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#2E9E72\",\n      \"tool\": []\n    };\n  }\n}\n\nBlockly.Python[\"custom_proptx_first_four\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var colors = Blockly.Python.valueToCode(block, 'colors', Blockly.Python.ORDER_FUNCTION_CALL) || \"[]\";\n  return [varname + \".first_four(\" + colors + \")\", Blockly.Python.ORDER_NONE];\n}\n\nBlockly.Blocks[\"custom_proptx_rgb_color\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_PROPTX_RGB_COLOR,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_proptxOptions\n        },\n        {\n          'type': 'input_value',\n          'name': 'r'\n        },\n        {\n          'type': 'input_value',\n          'name': 'g'\n        },\n        {\n          'type': 'input_value',\n          'name': 'b'\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#2E9E72\",\n      \"tool\": []\n    };\n  }\n}\n\nBlockly.Python[\"custom_proptx_rgb_color\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var r = Blockly.Python.valueToCode(block, 'r', Blockly.Python.ORDER_FUNCTION_CALL) || \"255\";\n  var g = Blockly.Python.valueToCode(block, 'g', Blockly.Python.ORDER_FUNCTION_CALL) || \"0\";\n  var b = Blockly.Python.valueToCode(block, 'b', Blockly.Python.ORDER_FUNCTION_CALL) || \"0\";\n  return [varname + \".rgb_color(\" + r + \", \" + g + \", \" + b + \")\", Blockly.Python.ORDER_NONE];\n}\n\nBlockly.Blocks[\"custom_proptx_rgb888\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_PROPTX_RGB888,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_proptxOptions\n        },\n        {\n          'type': 'input_value',\n          'name': 'color'\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#2E9E72\",\n      \"tool\": []\n    };\n  }\n}\n\nBlockly.Python[\"custom_proptx_rgb888\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var color = Blockly.Python.valueToCode(block, 'color', Blockly.Python.ORDER_FUNCTION_CALL) || \"(255, 0, 0)\";\n  return [varname + \".rgb888(\" + color + \")\", Blockly.Python.ORDER_NONE];\n}","toolbox":"\n<category name=\"PropTx\" colour=\"#2E9E72\" hidden=\"true\" toolboxitemid=\"custom_proptx\">\n<title text=\"PropTx\" docsLink=\"https://github.com/atrep123/m5-prop-lora\"></title>\n<block type=\"custom_proptx_init\">\n  <value name=\"tx\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">13</field>\n    </shadow>\n  </value>\n  <value name=\"rx\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">15</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_proptx_preview\">\n  <value name=\"colors\"/>\n</block><block type=\"custom_proptx_fire\">\n  <value name=\"colors\"/>\n</block><block type=\"custom_proptx_stop\"/><block type=\"custom_proptx_arm\"/><block type=\"custom_proptx_reply\"/><block type=\"custom_proptx_default_colors\"/><block type=\"custom_proptx_first_four\">\n  <value name=\"colors\"/>\n</block><block type=\"custom_proptx_rgb_color\">\n  <value name=\"r\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">255</field>\n    </shadow>\n  </value>\n  <value name=\"g\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n  <value name=\"b\">\n    <shadow type=\"math_number\">\n      <field name=\"NUM\">0</field>\n    </shadow>\n  </value>\n</block><block type=\"custom_proptx_rgb888\">\n  <value name=\"color\"/>\n</block>\n</category>\n","toolboxitemid":"custom_proptx","block_type":["custom_proptx_init","custom_proptx_preview","custom_proptx_fire","custom_proptx_stop","custom_proptx_arm","custom_proptx_reply","custom_proptx_default_colors","custom_proptx_first_four","custom_proptx_rgb_color","custom_proptx_rgb888"]},"data":{"name":"PropTx","note":{"en":"Prop TX UIFlow2 bridge for the authenticated prop_frame sender."},"details":{"color":"#2E9E72","link":"https://github.com/atrep123/m5-prop-lora","image":"","category":"Custom"},"header":{"file":"PropTx","time":"2026-06-10","author":"","email":"","license":"MIT License"},"assignments":[],"example":"","source_internal":"","source_external":"","members":[{"name":"__init__","note":{},"label":{"en":"%1 Prop init TX %2 RX %3"},"params":[{"name":"tx","type":"int","default":"13","note":{},"field":"number","max":"48","min":"0"},{"name":"rx","type":"int","default":"15","note":{},"field":"number","max":"48","min":"0"}],"return":"","source":"        import prop_frame\n        import prop_ui\n        from hardware import UART\n\n        self._uart = UART(1, baudrate=115200, bits=8, parity=None, stop=1, tx=tx, rx=rx)\n        self._tx = prop_frame.PropSender()\n        self._prop_frame = prop_frame\n        self._prop_ui = prop_ui\n        self._colors = self.default_colors()\n        self._armed = False\n        self._uart.write(\"\\n\")","ast_return":{"code":null,"id":null},"doc_return":null},{"name":"preview","note":{},"label":{"en":"Prop PREVIEW %1 colors %2"},"params":[{"name":"colors","type":"list","default":null,"note":{},"field":""}],"return":"","source":"        self._uart.write(self._tx.preview_line(_first_four_for_frame(self, colors)))","ast_return":{"code":null,"id":null},"doc_return":null},{"name":"fire","note":{},"label":{"en":"Prop ODPAL %1 colors %2"},"params":[{"name":"colors","type":"list","default":null,"note":{},"field":""}],"return":"","source":"        if not self._armed:\n            raise RuntimeError(\"Prop FIRE requires Prop ARM first\")\n        delay_ms = _delay_ms_or_raise(\n            \"time.sleep_ms or time.sleep is required for Prop FIRE burst timing\"\n        )\n        lines = self._tx.fire_burst_lines(_first_four_for_frame(self, colors))\n        for index, line in enumerate(lines):\n            self._uart.write(line)\n            # Keep redundant FIRE copies spaced by the protocol constant; the\n            # receiver dedups them by sequence, but the modem still needs air gap.\n            if index + 1 < len(lines):\n                delay_ms(self._prop_frame.FIRE_BURST_GAP_MS)\n        self._armed = False","ast_return":{"code":null,"id":null},"doc_return":null},{"name":"stop","note":{},"label":{"en":"Prop STOP %1"},"params":[],"return":"","source":"        delay_ms = _delay_ms_or_raise(\n            \"time.sleep_ms or time.sleep is required for Prop STOP retry timing\"\n        )\n        lines = self._tx.stop_lines()\n        for index, line in enumerate(lines):\n            self._uart.write(line)\n            if index + 1 < len(lines):\n                delay_ms(self._prop_frame.STOP_RETRY_GAP_MS)\n        self._armed = False","ast_return":{"code":null,"id":null},"doc_return":null},{"name":"arm","note":{},"label":{"en":"Prop ARM %1"},"params":[],"return":"","source":"        for line in self._tx.arm_lines():\n            self._uart.write(line)\n        self._armed = True","ast_return":{"code":null,"id":null},"doc_return":null},{"name":"reply","note":{},"label":{"en":"Prop reply %1"},"params":[],"return":"","source":"        if not self._uart.any():\n            return \"\"\n        data = self._uart.read() or b\"\"\n        if isinstance(data, str):\n            return data\n        try:\n            return data.decode(\"utf-8\", \"ignore\")\n        except Exception:\n            return \"\"","ast_return":{"code":null,"id":null},"doc_return":null},{"name":"default_colors","note":{},"label":{"en":"Prop default colors %1"},"params":[],"return":"","source":"        self._colors = self._prop_ui.palette_from_hues(DEFAULT_HUES)\n        return list(self._colors)","ast_return":{"code":null,"id":null},"doc_return":null},{"name":"first_four","note":{},"label":{"en":"Prop first four %1 colors %2"},"params":[{"name":"colors","type":"list","default":null,"note":{},"field":""}],"return":"","source":"        return list(colors)[:4]","ast_return":{"code":null,"id":null},"doc_return":null},{"name":"rgb_color","note":{},"label":{"en":"Prop RGB %1 R %2 G %3 B %4"},"params":[{"name":"r","type":"int","default":"255","note":{},"field":"number","max":"255","min":"0"},{"name":"g","type":"int","default":"0","note":{},"field":"number","max":"255","min":"0"},{"name":"b","type":"int","default":"0","note":{},"field":"number","max":"255","min":"0"}],"return":"","source":"        def clamp(value):\n            return max(0, min(255, int(value)))\n\n        return (clamp(r), clamp(g), clamp(b))","ast_return":{"code":null,"id":null},"doc_return":null},{"name":"rgb888","note":{},"label":{"en":"Prop RGB888 %1 color %2"},"params":[{"name":"color","type":"tuple","default":null,"note":{},"field":""}],"return":"","source":"        return self._prop_ui.rgb888(color)","ast_return":{"code":null,"id":null},"doc_return":null}],"python_file_name":"PropTx"},"pyCode":"\"\"\"\nfile     PropTx\ntime     2026-06-10\nauthor\nemail\nlicense  MIT License\n\"\"\"\n\n\ndef _remember_colors(instance, colors):\n    incoming = list(colors)\n    if len(incoming) == 4 and len(instance._colors) > 4:\n        instance._colors = incoming + list(instance._colors[4:])\n    else:\n        instance._colors = incoming\n    return incoming\n\n\ndef _first_four_for_frame(instance, colors):\n    return _remember_colors(instance, colors)[:4]\n\n\nDEFAULT_HUES = [0, 120, 240, 210, 60]\n\n\ndef _delay_ms_or_raise(message):\n    delay_ms = None\n    try:\n        import time\n\n        if hasattr(time, \"sleep_ms\"):\n            delay_ms = time.sleep_ms\n        elif hasattr(time, \"sleep\"):\n            delay_ms = lambda ms: time.sleep(ms / 1000)\n    except ImportError:\n        delay_ms = None\n    if delay_ms is None:\n        raise RuntimeError(message)\n    return delay_ms\n\n\nclass PropTx:\n    \"\"\"\n    note:\n        en: Prop TX UIFlow2 bridge for the authenticated prop_frame sender.\n    details:\n        color: '#2E9E72'\n        link: https://github.com/atrep123/m5-prop-lora\n        image: ''\n        category: Custom\n    example: ''\n    \"\"\"\n\n    def __init__(self, tx: int = 13, rx: int = 15):\n        \"\"\"\n        label:\n            en: '%1 Prop init TX %2 RX %3'\n        params:\n            tx:\n                name: tx\n                type: int\n                default: '13'\n                field: number\n                min: '0'\n                max: '48'\n            rx:\n                name: rx\n                type: int\n                default: '15'\n                field: number\n                min: '0'\n                max: '48'\n        \"\"\"\n        import prop_frame\n        import prop_ui\n        from hardware import UART\n\n        self._uart = UART(1, baudrate=115200, bits=8, parity=None, stop=1, tx=tx, rx=rx)\n        self._tx = prop_frame.PropSender()\n        self._prop_frame = prop_frame\n        self._prop_ui = prop_ui\n        self._colors = self.default_colors()\n        self._armed = False\n        self._uart.write(\"\\n\")\n\n    def preview(self, colors):\n        \"\"\"\n        label:\n            en: 'Prop PREVIEW %1 colors %2'\n        params:\n            colors:\n                name: colors\n                type: list\n        \"\"\"\n        self._uart.write(self._tx.preview_line(_first_four_for_frame(self, colors)))\n\n    def fire(self, colors):\n        \"\"\"\n        label:\n            en: 'Prop ODPAL %1 colors %2'\n        params:\n            colors:\n                name: colors\n                type: list\n        \"\"\"\n        if not self._armed:\n            raise RuntimeError(\"Prop FIRE requires Prop ARM first\")\n        delay_ms = _delay_ms_or_raise(\n            \"time.sleep_ms or time.sleep is required for Prop FIRE burst timing\"\n        )\n        lines = self._tx.fire_burst_lines(_first_four_for_frame(self, colors))\n        for index, line in enumerate(lines):\n            self._uart.write(line)\n            # Keep redundant FIRE copies spaced by the protocol constant; the\n            # receiver dedups them by sequence, but the modem still needs air gap.\n            if index + 1 < len(lines):\n                delay_ms(self._prop_frame.FIRE_BURST_GAP_MS)\n        self._armed = False\n\n    def stop(self):\n        \"\"\"\n        label:\n            en: 'Prop STOP %1'\n        \"\"\"\n        delay_ms = _delay_ms_or_raise(\n            \"time.sleep_ms or time.sleep is required for Prop STOP retry timing\"\n        )\n        lines = self._tx.stop_lines()\n        for index, line in enumerate(lines):\n            self._uart.write(line)\n            if index + 1 < len(lines):\n                delay_ms(self._prop_frame.STOP_RETRY_GAP_MS)\n        self._armed = False\n\n    def arm(self):\n        \"\"\"\n        label:\n            en: 'Prop ARM %1'\n        \"\"\"\n        for line in self._tx.arm_lines():\n            self._uart.write(line)\n        self._armed = True\n\n    def reply(self) -> str:\n        \"\"\"\n        label:\n            en: 'Prop reply %1'\n        \"\"\"\n        if not self._uart.any():\n            return \"\"\n        data = self._uart.read() or b\"\"\n        if isinstance(data, str):\n            return data\n        try:\n            return data.decode(\"utf-8\", \"ignore\")\n        except Exception:\n            return \"\"\n\n    def default_colors(self) -> list:\n        \"\"\"\n        label:\n            en: 'Prop default colors %1'\n        \"\"\"\n        self._colors = self._prop_ui.palette_from_hues(DEFAULT_HUES)\n        return list(self._colors)\n\n    def first_four(self, colors) -> list:\n        \"\"\"\n        label:\n            en: 'Prop first four %1 colors %2'\n        params:\n            colors:\n                name: colors\n                type: list\n        \"\"\"\n        return list(colors)[:4]\n\n    def rgb_color(self, r: int = 255, g: int = 0, b: int = 0) -> tuple:\n        \"\"\"\n        label:\n            en: 'Prop RGB %1 R %2 G %3 B %4'\n        params:\n            r:\n                name: r\n                type: int\n                default: '255'\n                field: number\n                min: '0'\n                max: '255'\n            g:\n                name: g\n                type: int\n                default: '0'\n                field: number\n                min: '0'\n                max: '255'\n            b:\n                name: b\n                type: int\n                default: '0'\n                field: number\n                min: '0'\n                max: '255'\n        \"\"\"\n\n        def clamp(value):\n            return max(0, min(255, int(value)))\n\n        return (clamp(r), clamp(g), clamp(b))\n\n    def rgb888(self, color) -> int:\n        \"\"\"\n        label:\n            en: 'Prop RGB888 %1 color %2'\n        params:\n            color:\n                name: color\n                type: tuple\n        \"\"\"\n        return self._prop_ui.rgb888(color)\n\n","version":"alpha2"}