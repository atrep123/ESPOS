{"category":"PropTx","color":"#2E9E72","uiflow2":{"jscode":"const CUSTOM_PROPTX_LANGUAGES = {\n  \"CUSTOM_PROPTX_INIT\": {\n    \"en\": \"%1 Prop init TX %2 RX %3\"\n  },\n  \"CUSTOM_PROPTX_PREVIEW\": {\n    \"en\": \"Prop PREVIEW %1 colors %2\"\n  },\n  \"CUSTOM_PROPTX_FIRE\": {\n    \"en\": \"Prop ODPAL %1 colors %2\"\n  },\n  \"CUSTOM_PROPTX_STOP\": {\n    \"en\": \"Prop STOP %1\"\n  },\n  \"CUSTOM_PROPTX_ARM\": {\n    \"en\": \"Prop ARM %1\"\n  },\n  \"CUSTOM_PROPTX_REMOTE_LED\": {\n    \"en\": \"Prop remote LED %1 which %2\"\n  },\n  \"CUSTOM_PROPTX_SYNC_PALETTE\": {\n    \"en\": \"Prop sync palette %1 colors %2\"\n  },\n  \"CUSTOM_PROPTX_REPLY\": {\n    \"en\": \"Prop reply %1\"\n  },\n  \"CUSTOM_PROPTX_HUE_COLOR\": {\n    \"en\": \"Prop hue %1 deg %2 to color\"\n  },\n  \"CUSTOM_PROPTX_DEFAULT_HUES\": {\n    \"en\": \"Prop default hues %1\"\n  },\n  \"CUSTOM_PROPTX_DEFAULT_COLORS\": {\n    \"en\": \"Prop default colors %1\"\n  },\n  \"CUSTOM_PROPTX_PALETTE_FROM_HUES\": {\n    \"en\": \"Prop colors from hues %1 hues %2\"\n  },\n  \"CUSTOM_PROPTX_SET_COLOR\": {\n    \"en\": \"Prop set color %1 colors %2 LED %3 color %4\"\n  },\n  \"CUSTOM_PROPTX_FIRST_FOUR\": {\n    \"en\": \"Prop first four %1 colors %2\"\n  },\n  \"CUSTOM_PROPTX_RGB_COLOR\": {\n    \"en\": \"Prop RGB %1 R %2 G %3 B %4\"\n  },\n  \"CUSTOM_PROPTX_RGB888\": {\n    \"en\": \"Prop RGB888 %1 color %2\"\n  },\n  \"CUSTOM_PROPTX_REMOTE_LED3\": {\n    \"en\": \"Prop remote LED3 %1\"\n  },\n  \"CUSTOM_PROPTX_REMOTE_LED5\": {\n    \"en\": \"Prop remote LED5 %1\"\n  }\n};\n\nconst initType = 'custom_proptx_init';\nBlockly.BlockRegExpList['custom_proptx'] = {\n  regexp: new RegExp(/^custom_proptx_/),\n  code: \"from PropTx import PropTx\",\n  initBlockType: initType,\n  categoryId: 'custom_proptx',\n}\nBlockly.utils.registerLanguages(CUSTOM_PROPTX_LANGUAGES)\n\nBlockly.Msg.CUSTOM_PROPTX_HUE = '#2E9E72'\nBlockly.Msg.CUSTOM_PROPTX = 'PropTx'\n\nBlockly.utils.getcustom_proptxOptions = function() {\n  let options = [];\n  let list = Blockly.utils.getCustomNameList(initType);\n  for (let i = 0; i < list.length; i++) {\n    let value = list[i];\n    options.push([String(value), String(value)]);\n  }\n  if (options.length === 0) return [\n    ['proptx_0', 'proptx_0']\n  ];\n  return options;\n}\n\nBlockly.Blocks[\"custom_proptx_init\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_PROPTX_INIT,\n      'args0': [\n        {\n          'type': 'field_input',\n          'name': 'NAME',\n          'text': 'proptx_0'\n        },\n        {\n          'type': 'input_value',\n          'name': 'tx'\n        },\n        {\n          'type': 'input_value',\n          'name': 'rx'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#2E9E72\",\n      \"tool\": []\n    };\n  }\n}\n\nBlockly.Python[\"custom_proptx_init\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var tx = Blockly.Python.valueToCode(block, 'tx', Blockly.Python.ORDER_FUNCTION_CALL) || \"13\";\n  var rx = Blockly.Python.valueToCode(block, 'rx', Blockly.Python.ORDER_FUNCTION_CALL) || \"15\";\n  return varname + \" = PropTx(\" + tx + \", \" + rx + \")\\n\";\n}\n\nBlockly.Blocks[\"custom_proptx_preview\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_PROPTX_PREVIEW,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_proptxOptions\n        },\n        {\n          'type': 'input_value',\n          'name': 'colors'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#2E9E72\",\n      \"tool\": []\n    };\n  }\n}\n\nBlockly.Python[\"custom_proptx_preview\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var colors = Blockly.Python.valueToCode(block, 'colors', Blockly.Python.ORDER_FUNCTION_CALL) || \"[]\";\n  return varname + \".preview(\" + colors + \")\" + \"\\n\";\n}\n\nBlockly.Blocks[\"custom_proptx_fire\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_PROPTX_FIRE,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_proptxOptions\n        },\n        {\n          'type': 'input_value',\n          'name': 'colors'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#2E9E72\",\n      \"tool\": []\n    };\n  }\n}\n\nBlockly.Python[\"custom_proptx_fire\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var colors = Blockly.Python.valueToCode(block, 'colors', Blockly.Python.ORDER_FUNCTION_CALL) || \"[]\";\n  return varname + \".fire(\" + colors + \")\" + \"\\n\";\n}\n\nBlockly.Blocks[\"custom_proptx_stop\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_PROPTX_STOP,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_proptxOptions\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#2E9E72\",\n      \"tool\": []\n    };\n  }\n}\n\nBlockly.Python[\"custom_proptx_stop\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  return varname + \".stop()\" + \"\\n\";\n}\n\nBlockly.Blocks[\"custom_proptx_arm\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_PROPTX_ARM,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_proptxOptions\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#2E9E72\",\n      \"tool\": []\n    };\n  }\n}\n\nBlockly.Python[\"custom_proptx_arm\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  return varname + \".arm()\" + \"\\n\";\n}\n\nBlockly.Blocks[\"custom_proptx_remote_led\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_PROPTX_REMOTE_LED,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_proptxOptions\n        },\n        {\n          'type': 'input_value',\n          'name': 'which'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#2E9E72\",\n      \"tool\": []\n    };\n  }\n}\n\nBlockly.Python[\"custom_proptx_remote_led\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var which = Blockly.Python.valueToCode(block, 'which', Blockly.Python.ORDER_FUNCTION_CALL) || \"3\";\n  return varname + \".remote_led(\" + which + \")\" + \"\\n\";\n}\n\nBlockly.Blocks[\"custom_proptx_sync_palette\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_PROPTX_SYNC_PALETTE,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_proptxOptions\n        },\n        {\n          'type': 'input_value',\n          'name': 'colors'\n        },\n      ],\n      'previousStatement': null,\n      'nextStatement': null,\n      'inputsInline': true,\n      'colour': \"#2E9E72\",\n      \"tool\": []\n    };\n  }\n}\n\nBlockly.Python[\"custom_proptx_sync_palette\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var colors = Blockly.Python.valueToCode(block, 'colors', Blockly.Python.ORDER_FUNCTION_CALL) || \"[]\";\n  return varname + \".sync_palette(\" + colors + \")\" + \"\\n\";\n}\n\nBlockly.Blocks[\"custom_proptx_reply\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_PROPTX_REPLY,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_proptxOptions\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#2E9E72\",\n      \"tool\": []\n    };\n  }\n}\n\nBlockly.Python[\"custom_proptx_reply\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  return [varname + \".reply()\", Blockly.Python.ORDER_NONE];\n}\n\nBlockly.Blocks[\"custom_proptx_hue_color\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_PROPTX_HUE_COLOR,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_proptxOptions\n        },\n        {\n          'type': 'input_value',\n          'name': 'deg'\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#2E9E72\",\n      \"tool\": []\n    };\n  }\n}\n\nBlockly.Python[\"custom_proptx_hue_color\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var deg = Blockly.Python.valueToCode(block, 'deg', Blockly.Python.ORDER_FUNCTION_CALL) || \"0\";\n  return [varname + \".hue_color(\" + deg + \")\", Blockly.Python.ORDER_NONE];\n}\n\nBlockly.Blocks[\"custom_proptx_default_hues\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_PROPTX_DEFAULT_HUES,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_proptxOptions\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#2E9E72\",\n      \"tool\": []\n    };\n  }\n}\n\nBlockly.Python[\"custom_proptx_default_hues\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  return [varname + \".default_hues()\", Blockly.Python.ORDER_NONE];\n}\n\nBlockly.Blocks[\"custom_proptx_default_colors\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_PROPTX_DEFAULT_COLORS,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_proptxOptions\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#2E9E72\",\n      \"tool\": []\n    };\n  }\n}\n\nBlockly.Python[\"custom_proptx_default_colors\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  return [varname + \".default_colors()\", Blockly.Python.ORDER_NONE];\n}\n\nBlockly.Blocks[\"custom_proptx_palette_from_hues\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_PROPTX_PALETTE_FROM_HUES,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_proptxOptions\n        },\n        {\n          'type': 'input_value',\n          'name': 'hues'\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#2E9E72\",\n      \"tool\": []\n    };\n  }\n}\n\nBlockly.Python[\"custom_proptx_palette_from_hues\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var hues = Blockly.Python.valueToCode(block, 'hues', Blockly.Python.ORDER_FUNCTION_CALL) || \"[0, 120, 240, 210, 60]\";\n  return [varname + \".palette_from_hues(\" + hues + \")\", Blockly.Python.ORDER_NONE];\n}\n\nBlockly.Blocks[\"custom_proptx_set_color\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_PROPTX_SET_COLOR,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_proptxOptions\n        },\n        {\n          'type': 'input_value',\n          'name': 'colors'\n        },\n        {\n          'type': 'input_value',\n          'name': 'index'\n        },\n        {\n          'type': 'input_value',\n          'name': 'color'\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#2E9E72\",\n      \"tool\": []\n    };\n  }\n}\n\nBlockly.Python[\"custom_proptx_set_color\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var colors = Blockly.Python.valueToCode(block, 'colors', Blockly.Python.ORDER_FUNCTION_CALL) || \"[]\";\n  var index = Blockly.Python.valueToCode(block, 'index', Blockly.Python.ORDER_FUNCTION_CALL) || \"1\";\n  var color = Blockly.Python.valueToCode(block, 'color', Blockly.Python.ORDER_FUNCTION_CALL) || \"(255, 0, 0)\";\n  return [varname + \".set_color(\" + colors + \", \" + index + \", \" + color + \")\", Blockly.Python.ORDER_NONE];\n}\n\nBlockly.Blocks[\"custom_proptx_first_four\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_PROPTX_FIRST_FOUR,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_proptxOptions\n        },\n        {\n          'type': 'input_value',\n          'name': 'colors'\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#2E9E72\",\n      \"tool\": []\n    };\n  }\n}\n\nBlockly.Python[\"custom_proptx_first_four\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var colors = Blockly.Python.valueToCode(block, 'colors', Blockly.Python.ORDER_FUNCTION_CALL) || \"[]\";\n  return [varname + \".first_four(\" + colors + \")\", Blockly.Python.ORDER_NONE];\n}\n\nBlockly.Blocks[\"custom_proptx_rgb_color\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_PROPTX_RGB_COLOR,\n      'args0': [\n        {\n          'type': 'field_dropdown',\n          'name': 'NAME',\n          'options': Blockly.utils.getcustom_proptxOptions\n        },\n        {\n          'type': 'input_value',\n          'name': 'r'\n        },\n        {\n          'type': 'input_value',\n          'name': 'g'\n        },\n        {\n          'type': 'input_value',\n          'name': 'b'\n        },\n      ],\n      'output': null,\n      'inputsInline': true,\n      'colour': \"#2E9E72\",\n      \"tool\": []\n    };\n  }\n}\n\nBlockly.Python[\"custom_proptx_rgb_color\"] = function(block) {\n  var varname = block.getFieldValue('NAME') || '_';\n  var r = Blockly.Python.valueToCode(block, 'r', Blockly.Python.ORDER_FUNCTION_CALL) || \"255\";\n  var g = Blockly.Python.valueToCode(block, 'g', Blockly.Python.ORDER_FUNCTION_CALL) || \"0\";\n  var b = Blockly.Python.valueToCode(block, 'b', Blockly.Python.ORDER_FUNCTION_CALL) || \"0\";\n  return [varname + \".rgb_color(\" + r + \", \" + g + \", \" + b + \")\", Blockly.Python.ORDER_NONE];\n}\n\nBlockly.Blocks[\"custom_proptx_rgb888\"] = {\n  init: function() {\n    this.jsonInit(this._init());\n  },\n  _init: function() {\n    return {\n      'message0': Blockly.Msg.CUSTOM_PROPTX_RGB888,\n      'args0': [\n        {\n          'type': 'fi